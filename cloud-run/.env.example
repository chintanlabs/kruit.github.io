# Gmail address used to send emails (create a dedicated one, e.g. kruitsupport@gmail.com)
# This will appear in the "From" header as:  Kruit.ai <GMAIL_USER>
GMAIL_USER=support@example.com

# Gmail App Password — NOT your normal password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Gmail account)
GMAIL_APP_PASSWORD=app_password_here

# Kruit team inbox that receives demo-request notifications
TO_EMAIL=sales@example.com

# Comma-separated list of allowed CORS origins
# Use * during development, restrict to your domain in production
# Example: https://kruit.ai,https://www.kruit.ai
ALLOWED_ORIGINS=https://kruit.ai,https://www.kruit.ai,http://localhost:8080
